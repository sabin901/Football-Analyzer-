{
  "name": "footlyzer",
  "version": "1.0.0",
  "private": true,
  "description": "Football analysis with reproducible data and a static browser interface",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "format": "prettier --write \"frontend/*.{js,css,html}\" \"tests/*.cjs\"",
    "format:check": "prettier --check \"frontend/*.{js,css,html}\" \"tests/*.cjs\""
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "engines": {"node": ">=22"}
}
